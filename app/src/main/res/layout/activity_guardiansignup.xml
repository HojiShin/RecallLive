<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAF7F2"
    tools:context=".GuardianSignupActivity">

    <!-- App Title with Brain Icon -->
    <!--    <ImageView-->
    <!--        android:id="@+id/iv_app_logo"-->
    <!--        android:layout_width="40dp"-->
    <!--        android:layout_height="40dp"-->
    <!--        android:layout_marginTop="32dp"-->
    <!--        android:layout_marginEnd="10dp"-->
    <!--        android:src="@drawable/ic_brain"-->
    <!--        android:contentDescription="Brain Logo"-->
    <!--        app:layout_constraintEnd_toStartOf="@id/ll_app_title"-->
    <!--        app:layout_constraintTop_toTopOf="parent"-->
    <!--        app:layout_constraintBottom_toBottomOf="@id/ll_app_title" />-->

    <!-- App Title Container -->
    <LinearLayout
        android:id="@+id/ll_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recall"
            android:textColor="#1C1917"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live"
            android:textColor="#0F766E"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1C1917"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/ll_app_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <!-- Patient Button (Outlined style) -->
    <Button
        android:id="@+id/btnPatient"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Member"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"
        android:textColor="#0F766E"
        app:strokeColor="#0F766E"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnGuardian"
        app:layout_constraintWidth_percent="0.45"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp" />

    <!-- Guardian Button (Filled style) -->
    <Button
        android:id="@+id/btnGuardian"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Care Partner"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#0F766E"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toEndOf="@id/btnPatient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.45"
        android:layout_marginTop="32dp"
        android:layout_marginStart="8dp" />

    <!-- Email/Phone Label -->
    <TextView
        android:id="@+id/tvEmailPhoneLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email/Phone number"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1C1917"
        app:layout_constraintTop_toBottomOf="@id/btnPatient"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Email/Phone EditText -->
    <EditText
        android:id="@+id/etEmailPhone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:hint="Enter your email or phone"
        android:textColorHint="#78716C"
        android:textColor="#1C1917"
        android:inputType="textEmailAddress"
        android:background="#FFFFFF"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvEmailPhoneLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Password Label -->
    <TextView
        android:id="@+id/tvPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1C1917"
        app:layout_constraintTop_toBottomOf="@id/etEmailPhone"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Password EditText -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:hint="Enter your password"
        android:textColorHint="#78716C"
        android:textColor="#1C1917"
        android:inputType="textPassword"
        android:background="#FFFFFF"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Sign Up Button -->
    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Sign up"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#0F766E"
        android:textColor="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <!-- Already have account text -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAlreadyHaveAccountGuardian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:text="Already have an account? Login"
        android:textColor="#0F766E"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSignUp"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>