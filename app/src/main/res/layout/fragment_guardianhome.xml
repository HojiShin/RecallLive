<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- AI Chat Button - NEW -->
        <Button
            android:id="@+id/btn_ai_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 Ask AI About Emotions"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp" />

        <!-- Facial Expression Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_quiz_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Facial Expression Analysis"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Graph Container -->
                <FrameLayout
                    android:id="@+id/graph_container"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_quiz_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📊 No emotion data yet\n\nStart watching videos to see analysis"
                        android:textColor="#888888"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Explanation Text -->
                <TextView
                    android:id="@+id/tv_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No emotion data available yet. Emotion tracking will appear here once videos are watched."
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Videos with Emotions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 Videos and Emotions"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Video List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_videos_emotions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_video_emotion" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>